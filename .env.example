# ============================================================
# DataBreakers CRM - environment configuration
# Copy this file to ".env" and edit the values.
# NEVER commit the real .env file to version control.
# ============================================================

# --- Core Flask settings ---
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Use a fixed value only in development. In production generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# --- Database (SQLite by default) ---
DATABASE_URL=sqlite:///databreakers_crm.db

# --- Security (production) ---
# Set to 1 when serving over HTTPS.
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax
REMEMBER_COOKIE_SECURE=0

# --- Trusted hosts (comma separated), e.g. example.com,www.example.com ---
# Leave empty in development.
PREFERRED_URL_SCHEME=http

# --- Admin bootstrap (scripts/init_db.py --create-admin reads these) ---
# Leave ADMIN_PASSWORD empty and the script will prompt for it interactively.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Zia AI (optional LLM provider) ---
# DataBreakers works fully without an LLM. If a key is set, Zia uses it to
# word the answer; otherwise Zia answers with the built-in deterministic
# analytics engine. Keys are read ONLY on the server.
ZIA_LLM_API_KEY=
ZIA_LLM_BASE_URL=https://api.openai.com/v1
ZIA_LLM_MODEL=gpt-4o-mini
ZIA_LLM_TIMEOUT_SECONDS=30
